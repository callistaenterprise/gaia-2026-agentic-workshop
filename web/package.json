{
  "name": "agenticworkshop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:agent": "mastra dev",
    "dev:ui": "next dev --turbopack",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx src/backend/db/seed.ts",
    "db:index": "npx tsx --env-file=.env.local src/backend/db/indexData.ts",
    "db:reset": "rm -f ../db/chat-agent.db ../db/chat-agent.db-shm ../db/chat-agent.db-wal ../db/mastra.db ../db/mastra.db-shm ../db/mastra.db-wal && npm run db:seed && npm run db:index",
    "test-exercise-1": "npx tsx --tsconfig tsconfig.json test-exercises/exercise_1.ts"
  },
